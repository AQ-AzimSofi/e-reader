# Copy this file to .env.local and fill in your actual values
# cp .env.local.example .env.local

# ============================================================================
# Google Gemini AI API Key (REQUIRED)
# ============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Google Cloud Text-to-Speech (separate API key with the Text-to-Speech API enabled)
# ============================================================================
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# ============================================================================
# Local Development Database (Docker Compose)
# ============================================================================
# This connects to the PostgreSQL database defined in docker-compose.yml
# Update the password if you changed it in docker-compose.yml (default: 123)
DATABASE_URL="postgres://postgres:123@localhost:5433/yomi_sapo"

# ============================================================================
# Book asset buckets (created by the production SST deploy)
# ============================================================================
# Cover art served by /api/covers, and in-book illustrations + image metadata
# served by /api/book-assets. Find the names with:
#   aws s3api list-buckets --query "Buckets[?starts_with(Name, 'yomi-sapo-production-book')].Name"
BOOK_COVERS_BUCKET=
BOOK_IMAGES_BUCKET=

# ============================================================================
# Production (Vercel) - DO NOT SET THESE LOCALLY
# ============================================================================
# When deployed to Vercel, the following variables are automatically set
# by Vercel Postgres. You don't need to configure them manually:
# - POSTGRES_URL
# - POSTGRES_PRISMA_URL
# - POSTGRES_URL_NON_POOLING
# - POSTGRES_USER
# - POSTGRES_HOST
# - POSTGRES_PASSWORD
# - POSTGRES_DATABASE
